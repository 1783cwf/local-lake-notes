{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Lake Notes",
  "version": "1.4.0",
  "identifier": "com.weistuday.yuque.lake-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Lake Notes",
        "width": 1440,
        "height": 920,
        "minWidth": 920,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://gw.alipayobjects.com data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/resource-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons-local-lake-notes/32x32.png",
      "icons-local-lake-notes/128x128.png",
      "icons-local-lake-notes/128x128@2x.png",
      "icons-local-lake-notes/icon.icns",
      "icons-local-lake-notes/icon.ico",
      "icons-local-lake-notes/icon.png"
    ]
  }
}
