{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yuque Lake Notes",
  "version": "0.1.0",
  "identifier": "com.weistuday.yuque.lake-notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yuque Lake Notes",
        "width": 1440,
        "height": 920,
        "minWidth": 920,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: http: data: blob:; font-src 'self' https: http: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
